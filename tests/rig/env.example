# Copy to .env.rig at the repo root (gitignored). Read by scripts/rig.py.
# HA_TOKEN: a long-lived token for a NON-admin user; the rig only calls services and reads states.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# HA_ADMIN_TOKEN: an admin user's token, for ZHA and Zigbee2MQTT suites (admin-only cluster command, MQTT) and
# for setting device_side's options for suites whose adapter has them (Hue move and stop).
HA_ADMIN_TOKEN=
# Full shell commands for the maintainer's deploy tooling. These are not in the repo.
# RIG_SYNC_CMD: syncs the pushed branch into the rig and replaces the installed integration.
# RIG_STATUS_CMD: prints the tree hash currently installed; exits 91 if never synced.
# RIG_RESTART_CMD: restarts Home Assistant.
RIG_SYNC_CMD=
RIG_STATUS_CMD=
RIG_RESTART_CMD=
# RIG_PAUSE: comma-separated automations and switches turned off for the run and back on after it, for whatever
# would fight the tests (motion lighting, an Adaptive Lighting instance's switch). Only those that were on are
# turned back on.
RIG_PAUSE=
# HUE_BRIDGE_HOST, HUE_APP_KEY: the Hue bridge's address and an application key, for the `bridge` step, which writes
# to the bridge behind Home Assistant's back. Only a run of a Hue step file that uses `bridge` needs them.
HUE_BRIDGE_HOST=
HUE_APP_KEY=
