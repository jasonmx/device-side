# Copy to .env.rig at the repo root (gitignored). Read by scripts/rig.py and the rig fixtures.
# HA_TOKEN: a long-lived token for a NON-admin user; the rig only calls services and reads states.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# SSH alias whose key is pinned to pi-stack's ha-shim (ds-sync, ds-status, restart).
RIG_SSH=ha
